{
  "steps": [
    {
      "type": "generate_backup",
      "file": "b.conf",
      "sections": [
        {
          "text": "config system global\n  set hostname demo\nend\n"
        },
        {
          "binary": 300
        },
        {
          "text": "config late\nend\n"
        }
      ]
    },
    {
      "type": "open",
      "file": "b.conf"
    },
    {
      "type": "click",
      "line": 6,
      "column": 12
    },
    {
      "type": "key",
      "key": "delete"
    },
    {
      "type": "text",
      "text": "2"
    },
    {
      "type": "answer",
      "with": "OK"
    },
    {
      "type": "menu",
      "action": "Save"
    },
    {
      "type": "assert",
      "what": "last_prompt",
      "contains": "file_number"
    },
    {
      "type": "assert",
      "what": "dirty",
      "equals": true
    },
    {
      "type": "assert",
      "what": "file_unchanged",
      "file": "b.conf",
      "equals": true
    },
    {
      "type": "quit"
    }
  ]
}