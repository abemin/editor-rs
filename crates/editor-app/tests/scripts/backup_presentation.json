{
  "steps": [
    {
      "type": "generate_backup",
      "file": "b.conf",
      "sections": [
        {
          "text": "config system global\n  set hostname demo\nend\n"
        },
        {
          "binary": 300
        },
        {
          "text": "config late\nend\n"
        }
      ]
    },
    {
      "type": "open",
      "file": "b.conf"
    },
    {
      "type": "assert",
      "what": "status",
      "contains": "1 protected section"
    },
    {
      "type": "assert",
      "what": "line_text",
      "line": 28,
      "contains": "[locked: /data/config/section1.conf.gz"
    },
    {
      "type": "click",
      "line": 28,
      "column": 3
    },
    {
      "type": "text",
      "text": "x"
    },
    {
      "type": "assert",
      "what": "dirty",
      "equals": false
    },
    {
      "type": "assert",
      "what": "notice",
      "contains": "protected"
    },
    {
      "type": "render",
      "name": "backup_presentation"
    },
    {
      "type": "quit"
    }
  ]
}