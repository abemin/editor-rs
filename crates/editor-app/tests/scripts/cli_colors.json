    },
    {
      "type": "assert",
      "what": "role_at",
      "line": 7,
      "column": 19,
      "equals": "SecretValue"
    },
    {
      "type": "assert",
      "what": "role_at",
      "line": 8,
      "column": 13,
      "equals": "Action"
    },
    {
      "type": "assert",
      "what": "role_at",
      "line": 9,
      "column": 15,
      "equals": "SeverityHigh"
