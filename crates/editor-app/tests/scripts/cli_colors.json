    {
      "type": "assert",
      "what": "role_at",
      "line": 2,
      "column": 6,
      "equals": "Property"
    },
    {
      "type": "assert",
      "what": "role_at",
      "line": 2,
      "column": 15,
      "equals": "String"
    },
    {
      "type": "assert",
