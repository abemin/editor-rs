{
  "steps": [
    {
      "type": "generate_backup",
      "file": "b.conf",
      "sections": [
        {
          "text": "config system global\n  set hostname demo\nend\n"
        },
        {
          "binary": 300
        }
      ]
    },
    {
      "type": "open",
      "file": "b.conf"
    },
    {
      "type": "menu",
      "action": "FindAndReplace"
    },
    {
      "type": "find",
      "pattern": "demo",
      "replace": "lab"
    },
    {
      "type": "find_button",
      "button": "Replace All"
    },
    {
      "type": "menu",
      "action": "Save"
    },
    {
      "type": "assert",
      "what": "file_matches",
      "file": "b.conf",
      "replace": [
        "hostname demo",
        "hostname lab"
      ],
      "equals": true
    },
    {
      "type": "quit"
    }
  ]
}